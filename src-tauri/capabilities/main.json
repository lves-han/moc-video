{
  "identifier": "main",
  "description": "Packaged main WebView: fixed business commands and player fullscreen.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-player-fullscreen",
    "allow-runtime-status",
    "allow-runtime-prepare",
    "allow-get-sources",
    "allow-sync-catalog",
    "allow-get-home",
    "allow-get-details",
    "allow-resolve-episode",
    "allow-open-playback",
    "allow-close-playback",
    "allow-cancel-request",
    "allow-start-interaction",
    "allow-finish-interaction",
    "allow-get-settings",
    "allow-save-settings",
    "allow-get-resource-status",
    "allow-release-resolution",
    "allow-match-playback",
    "allow-list-history",
    "allow-save-history",
    "allow-remove-history",
    "allow-clear-history",
    "allow-get-media-cache",
    "allow-clear-media-cache",
    "allow-list-watchlist",
    "allow-add-watchlist",
    "allow-remove-watchlist",
    "allow-search-catalog",
    "allow-get-live-channels",
    "allow-open-live",
    "allow-list-local-videos",
    "allow-open-local",
    "dialog:allow-open",
    "allow-app-close-started",
    "allow-app-close-aborted",
    "allow-app-close-ready",
    "allow-window-bounds-now",
    "allow-app-reset",
    "allow-app-reset-recovery",
    "allow-app-font-url"
  ]
}
