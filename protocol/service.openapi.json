          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid token"
          },
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/v1/sources": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List playback sources",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "sources"
                  ],
                  "properties": {
                    "sources": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PlaybackSource"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid source"
          },
          "401": {
            "description": "Invalid token"
          },
          "502": {
            "description": "Source check failed"
          }
        }
      },
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Create or reimport a source"
          },
          "400": {
            "description": "Invalid source"
          },
          "401": {
            "description": "Invalid token"
          },
          "502": {
            "description": "Source check failed"
          },
          "201": {
            "description": "Source saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaybackSource"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlaybackSourceInput"
              }
            }
          }
        }
      }
    },
    "/v1/sources/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Update a source",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaybackSource"
                }
              }
            }
          },
          "400": {
            "description": "Invalid source"
          },
          "401": {
            "description": "Invalid token"
          },
          "502": {
            "description": "Source check failed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
