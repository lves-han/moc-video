            "type": "integer"
          },
          "history": {
            "type": "object"
          },
          "play": {
            "type": "object",
            "required": [
              "url",
              "headers"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "LookupEvent": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "event",
              "lookup_id",
              "lease_expires_at",
              "sources"
            ],
            "properties": {
              "event": {
                "type": "string",
                "enum": [
                  "started"
                ]
              },
              "lookup_id": {
                "type": "string",
                "format": "uuid"
              },
              "lease_expires_at": {
                "type": "integer"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "event",
              "source_id",
              "status"
            ],
            "properties": {
              "event": {
                "type": "string",
                "enum": [
                  "source"
                ]
              },
              "source_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "searching",
                  "done",
                  "needs_confirmation",
                  "not_found",
                  "no_episode",
                  "unsupported",
                  "failed",
                  "timeout"
                ]
              },
              "lines": {
                "type": "integer"
              },
              "reason": {
                "type": "string",
                "description": "Reason a source cannot serve this target."
              },
              "error": {
                "type": "object"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "event",
              "source_id",
              "candidates"
            ],
            "properties": {
              "event": {
                "type": "string",
                "enum": [
                  "confirm"
                ]
              },
              "source_id": {
                "type": "string"
              },
              "candidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "candidate_id",
                    "title"
                  ],
                  "properties": {
                    "candidate_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "title": {
                      "type": "string"
                    },
                    "year": {
                      "type": "integer",
                      "nullable": true
                    },
                    "kind": {
                      "type": "string",
                      "nullable": true
                    },
                    "mismatch": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "event",
              "line"
            ],
            "properties": {
              "event": {
                "type": "string",
                "enum": [
                  "line"
                ]
              },
              "line": {
                "$ref": "#/components/schemas/PlaybackLine"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "event"
            ],
            "properties": {
              "event": {
                "type": "string",
                "enum": [
                  "done"
                ]
              },
              "status": {
                "type": "string"
              },
              "lease_expires_at": {
                "type": "integer",
                "nullable": true
              }
            }
          }
        ]
      },
      "ParserInput": {
        "type": "object",
        "required": [
          "name",
          "api"
        ],
        "properties": {
          "client_config_id": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "api": {
            "type": "string",
            "format": "uri"
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Empty matches all flags; * matches any flag."
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Headers sent to the parser API."
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "url_param": {
            "type": "string",
            "default": "url"
          },
          "url_field": {
            "type": "string",
            "default": "url",
            "description": "Dot-separated path to the playback URL in the JSON response."
          }
        }
      },
      "Parser": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ParserInput"
          },
          {
            "type": "object",
            "required": [
              "id",
              "revision",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "json"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
