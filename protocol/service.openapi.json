{
  "openapi": "3.0.3",
  "info": {
    "title": "Moc playback service",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Service health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/stremio/{token}/{source}/{lang}/manifest.json": {
      "get": {
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "zh-CN",
                "en-US"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stremio metadata response"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid service token or TMDB key"
          },
          "502": {
            "description": "TMDB upstream failure"
          },
          "503": {
            "description": "Home snapshot is being prepared; retry later"
          },
          "501": {
            "description": "The source does not declare this capability"
          }
        }
      }
    },
    "/stremio/{token}/{source}/{lang}/catalog/{type}/{id}.json": {
      "get": {
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "zh-CN",
                "en-US"
              ]
            }
          },
          {
            "name": "type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stremio metadata response"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid service token or TMDB key"
          },
          "502": {
            "description": "TMDB upstream failure"
          },
          "503": {
            "description": "Home snapshot is being prepared; retry later"
          },
          "501": {
            "description": "The source does not declare this capability"
          }
        }
      }
    },
    "/stremio/{token}/{source}/{lang}/catalog/{type}/{id}/{extra}.json": {
      "get": {
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "zh-CN",
                "en-US"
              ]
            }
          },
          {
            "name": "type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "extra",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stremio metadata response"
          },
          "400": {
            "description": "Invalid request"
