            "description": "Invalid source"
          },
          "401": {
            "description": "Invalid token"
          },
          "502": {
            "description": "Source check failed"
          },
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/v1/sources/{id}/check": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Check search and detail"
          },
          "400": {
            "description": "Invalid source"
          },
          "401": {
            "description": "Invalid token"
          },
          "502": {
            "description": "Source check failed"
          }
        },
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/sources/import": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Per-source and per-parser import results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "results",
                    "parsers"
                  ],
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "parsers": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid source"
          },
          "401": {
            "description": "Invalid token"
          },
          "502": {
            "description": "Source check failed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "format": {
                    "type": "string",
                    "enum": [
                      "tvbox",
                      "zyfun",
                      "zyfun-legacy",
                      "legacy"
                    ],
                    "default": "legacy"
                  },
                  "base_url": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "sites": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "site": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "parsers": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "parses": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "analyze": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/mappings": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "metadata_source_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "meta_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching mappings, including revoked entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "mappings"
                  ],
                  "properties": {
                    "mappings": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Mapping"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid metadata identity"
          },
          "401": {
            "description": "Invalid token"
          }
        }
      },
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "lookup_id",
                  "source_id",
                  "candidate_id"
                ],
                "properties": {
                  "lookup_id": {
                    "type": "string"
                  },
                  "source_id": {
                    "type": "string"
                  },
                  "candidate_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmed line events",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "string",
                  "description": "Newline-delimited LookupEvent JSON objects."
                },
                "x-item-schema": {
                  "$ref": "#/components/schemas/LookupEvent"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid token"
          },
          "410": {
            "description": "Handle expired or source changed"
          }
        }
      }
    },
    "/v1/mappings/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "delete": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Mapping revoked"
          },
          "401": {
            "description": "Invalid token"
          },
          "404": {
            "description": "Mapping not found"
          }
        }
      }
    },
    "/v1/lookups": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "metadata_source_id",
                  "type",
                  "meta_id",
                  "video_id",
                  "lang"
                ],
                "properties": {
                  "metadata_source_id": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "movie",
                      "series"
                    ]
                  },
                  "meta_id": {
                    "type": "string"
                  },
                  "video_id": {
                    "type": "string"
                  },
                  "lang": {
                    "type": "string",
                    "enum": [
                      "zh-CN",
                      "en-US"
                    ]
                  },
                  "sources": {
                    "type": "array",
                    "nullable": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "refresh": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lookup event stream",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "string",
                  "description": "Newline-delimited LookupEvent JSON objects."
                },
                "x-item-schema": {
                  "$ref": "#/components/schemas/LookupEvent"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid token"
          },
          "410": {
            "description": "Handle expired or source changed"
          }
        }
      }
    },
    "/v1/lookups/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "delete": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Lookup cancelled"
          },
          "410": {
            "description": "Lookup expired"
          }
        }
      }
    },
    "/v1/lines/{id}/refresh": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Same line with refreshed playback info",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaybackLine"
                }
              }
            }
          },
          "410": {
            "description": "Line disappeared, ambiguous, expired or source changed"
          },
          "502": {
            "description": "Upstream failed"
          }
        }
      }
    },
    "/v1/reports": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "line_id",
                  "outcome"
                ],
                "properties": {
                  "line_id": {
                    "type": "string"
                  },
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "playing",
                      "failed"
                    ]
                  },
                  "latency_ms": {
                    "type": "integer",
                    "nullable": true
                  },
                  "error_code": {
                    "type": "string",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Report recorded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid token"
          },
          "410": {
            "description": "Handle expired or source changed"
          }
        }
      }
    },
    "/v1/parsers": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Configured parsers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "parsers"
                  ],
                  "properties": {
                    "parsers": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Parser"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid token"
          }
        }
      },
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParserInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Parser saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Parser"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parser"
          },
          "401": {
            "description": "Invalid token"
          }
        }
      }
    },
    "/v1/parsers/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParserInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Parser updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Parser"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parser"
          },
          "401": {
            "description": "Invalid token"
          },
          "404": {
            "description": "Parser not found"
          }
        }
      },
      "delete": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "description": "Invalid token"
          },
          "404": {
            "description": "Parser not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "version",
          "status",
          "tmdb",
          "snapshot_at",
          "sources"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "tmdb": {
            "type": "string"
          },
          "snapshot_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix timestamp of the last successful home snapshot"
          },
          "sources": {
            "type": "integer",
            "nullable": true
          },
          "snapshot_error": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "PlaybackSourceInput": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "api"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "type": "string",
            "enum": [
              "maccms_json",
              "maccms_xml",
              "t4_query",
              "t4_drpyjs0",
              "t4_rest",
              "stremio_stream"
            ]
          },
          "api": {
            "type": "string",
            "format": "uri"
          },
          "client_config_id": {
            "type": "string",
            "nullable": true
          },
          "ext": {},
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "parse_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PlaybackSource": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PlaybackSourceInput"
          },
          {
            "type": "object",
            "required": [
              "id",
              "revision",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "configured",
                  "checking",
                  "ready",
                  "failed",
                  "disabled"
                ]
              },
              "checked_at": {
                "type": "integer",
                "nullable": true
              },
              "capabilities": {
                "type": "object",
                "description": "Cached Stremio stream manifest capabilities for the current source revision."
              }
            }
          }
        ]
      },
      "Mapping": {
        "type": "object",
        "required": [
          "id",
          "metadata_source_id",
          "type",
          "meta_id",
          "source_id",
          "source_revision",
          "content_id",
          "confirmed_by",
          "evidence",
          "updated_at",
          "revoked"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "metadata_source_id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "movie",
              "series"
            ]
          },
          "meta_id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "source_revision": {
            "type": "integer"
          },
          "content_id": {
            "type": "string"
          },
          "confirmed_by": {
            "type": "string",
            "enum": [
              "auto",
              "user"
            ]
          },
          "evidence": {
            "type": "object"
          },
          "updated_at": {
            "type": "integer"
          },
          "revoked": {
            "type": "boolean"
          }
        }
      },
      "LineTarget": {
        "type": "object",
        "required": [
          "metadata_source_id",
          "metadata_revision",
          "type",
          "meta_id",
          "video_id"
        ],
        "properties": {
          "metadata_source_id": {
            "type": "string"
          },
          "metadata_revision": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "enum": [
              "movie",
              "series"
            ]
          },
          "meta_id": {
            "type": "string"
          },
          "video_id": {
            "type": "string"
          }
        }
      },
      "PlaybackLine": {
        "type": "object",
        "required": [
          "line_id",
          "source_id",
          "source_revision",
          "line_name",
          "episode_label",
          "kind",
          "target",
          "expires_at",
          "history"
        ],
        "properties": {
          "line_id": {
            "type": "string",
            "format": "uuid"
          },
          "source_id": {
            "type": "string"
          },
          "source_revision": {
            "type": "integer"
          },
          "line_name": {
            "type": "string"
          },
          "episode_label": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "hls",
              "unsupported"
            ]
          },
          "quality": {
            "type": "string",
            "nullable": true
          },
          "target": {
            "$ref": "#/components/schemas/LineTarget"
          },
