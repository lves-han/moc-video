              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/stremio/{token}/{source}/{lang}/manifest.json": {
      "get": {
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "zh-CN",
                "en-US"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stremio metadata response"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid service token or TMDB key"
          },
          "502": {
            "description": "TMDB upstream failure"
          },
          "503": {
            "description": "Home snapshot is being prepared; retry later"
          },
          "501": {
            "description": "The source does not declare this capability"
          }
        }
      }
    },
