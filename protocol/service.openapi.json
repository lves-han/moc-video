          "401": {
            "description": "Invalid service token or TMDB key"
          },
          "502": {
            "description": "TMDB upstream failure"
          },
          "503": {
            "description": "Home snapshot is being prepared; retry later"
          },
          "501": {
            "description": "The source does not declare this capability"
          }
        }
      }
    },
    "/stremio/{token}/{source}/{lang}/meta/{type}/{id}.json": {
      "get": {
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "zh-CN",
                "en-US"
              ]
            }
          },
          {
            "name": "type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stremio metadata response"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid service token or TMDB key"
          },
          "502": {
            "description": "TMDB upstream failure"
          },
          "503": {
            "description": "Home snapshot is being prepared; retry later"
          },
          "501": {
            "description": "The source does not declare this capability"
          }
        }
      }
    },
    "/v1/metadata-sources": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List metadata sources"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid token"
          }
        }
      },
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Import addons with per-item results"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid token"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/v1/metadata-sources/import": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Import addons with per-item results"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid token"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/v1/metadata-sources/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Update a registered addon"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid token"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      },
      "delete": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Delete a registered addon"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid token"
          },
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/v1/sources": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List playback sources",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "sources"
                  ],
                  "properties": {
                    "sources": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PlaybackSource"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid source"
          },
          "401": {
            "description": "Invalid token"
          },
          "502": {
            "description": "Source check failed"
          }
        }
      },
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Create or reimport a source"
          },
          "400": {
            "description": "Invalid source"
          },
          "401": {
            "description": "Invalid token"
          },
          "502": {
            "description": "Source check failed"
          },
          "201": {
            "description": "Source saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaybackSource"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlaybackSourceInput"
              }
            }
          }
        }
      }
    },
    "/v1/sources/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Update a source",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaybackSource"
                }
              }
            }
          },
          "400": {
            "description": "Invalid source"
          },
          "401": {
            "description": "Invalid token"
          },
          "502": {
            "description": "Source check failed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlaybackSourceInput"
              }
            }
          }
        }
      },
      "delete": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Delete a source"
          },
          "400": {
            "description": "Invalid source"
          },
          "401": {
            "description": "Invalid token"
          },
          "502": {
            "description": "Source check failed"
          },
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/v1/sources/{id}/check": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Check search and detail"
          },
          "400": {
            "description": "Invalid source"
          },
          "401": {
            "description": "Invalid token"
          },
          "502": {
            "description": "Source check failed"
          }
        },
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/sources/import": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Import sources with per-item results"
          },
          "400": {
            "description": "Invalid source"
          },
          "401": {
            "description": "Invalid token"
          },
          "502": {
            "description": "Source check failed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/v1/mappings": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "metadata_source_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "meta_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching mappings, including revoked entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "mappings"
                  ],
                  "properties": {
                    "mappings": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Mapping"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid metadata identity"
          },
          "401": {
            "description": "Invalid token"
          }
        }
      }
    },
    "/v1/mappings/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "delete": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Mapping revoked"
          },
          "401": {
            "description": "Invalid token"
          },
          "404": {
            "description": "Mapping not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "version",
          "status",
          "tmdb",
          "snapshot_at",
          "sources"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "tmdb": {
            "type": "string"
          },
          "snapshot_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix timestamp of the last successful home snapshot"
          },
          "sources": {
            "type": "integer",
            "nullable": true
          },
          "snapshot_error": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "PlaybackSourceInput": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "api"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "type": "string",
            "enum": [
              "maccms_json",
              "maccms_xml"
            ]
          },
          "api": {
            "type": "string",
            "format": "uri"
          },
          "client_config_id": {
            "type": "string",
            "nullable": true
          },
          "ext": {},
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "parse_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PlaybackSource": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PlaybackSourceInput"
          },
          {
            "type": "object",
            "required": [
              "id",
              "revision",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "configured",
                  "checking",
                  "ready",
                  "failed",
                  "disabled"
                ]
              },
              "checked_at": {
                "type": "integer",
                "nullable": true
              }
            }
          }
        ]
      },
      "Mapping": {
        "type": "object",
        "required": [
          "id",
          "metadata_source_id",
          "type",
          "meta_id",
          "source_id",
          "source_revision",
          "content_id",
          "confirmed_by",
          "evidence",
          "updated_at",
          "revoked"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "metadata_source_id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "movie",
              "series"
            ]
          },
          "meta_id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "source_revision": {
            "type": "integer"
          },
          "content_id": {
            "type": "string"
          },
          "confirmed_by": {
            "type": "string",
            "enum": [
              "auto",
              "user"
            ]
          },
          "evidence": {
            "type": "object"
          },
          "updated_at": {
            "type": "integer"
          },
          "revoked": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
